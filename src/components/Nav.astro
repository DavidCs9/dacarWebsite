---
import Image from "astro/components/Image.astro";
import Logo from "../images/inicio.webp";

const sidebarItems = [
  {
    name: "Productos",
    href: "#productos",
  },
  {
    name: "Galeria",
    href: "#galeria",
  },
  {
    name: "Contacto",
    href: "#contacto",
  },
];
---

<nav
  class="fixed transition-all duration-500 top-0 left-0 w-full z-50 bg-gray-800 shadow-md -translate-y-full p-5 flex items-center justify-between"
>
  <a href="#hero" class="flex items-center gap-2 text-lg font-medium">
    <Image src={Logo} alt="PID logo" width={30} loading="eager" />
    DACAR
  </a>
  <button id="menu-button" aria-label="menu button">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 20 20"
      ><path
        fill="currentColor"
        fill-rule="evenodd"
        d="M2 8a1 1 0 0 1 1-1h10.308a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1m0-4a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1m0 8a1 1 0 0 1 1-1h14a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1m0 4a1 1 0 0 1 1-1h10.308a1 1 0 1 1 0 2H3a1 1 0 0 1-1-1"
        clip-rule="evenodd"></path>
    </svg>
  </button>
</nav>
<aside
  class="fixed top-0 right-0 w-3/4 text-gray-200 h-full bg-gray-800 shadow-xl translate-x-full z-40 transition-all duration-500 lg:w-[300px]"
>
  <div class="flex flex-col justify-between py-28 h-full">
    <ol class="flex flex-col gap-4 h-full pr-4 lg:pr-8 text-right">
      {
        sidebarItems.map((item) => (
          <li class="text-xl">
            <a
              href={item.href}
              class="block hover:text-[#005dcf] font-semibold"
            >
              {item.name}
            </a>
          </li>
        ))
      }
    </ol>
    <a
      href="#contact"
      class="text-xl bg-gradient-to-r from-blue-500 to-cyan-500 text-white py-2 w-44 px-4 rounded-full hover:bg-blue-600 items-center gap-2 justify-center tracking-wider flex mx-auto"
    >
      Contactanos
    </a>
  </div>
</aside>
<button
  id="sidemenu-bg"
  class="fixed top-0 bottom-0 left-0 w-full h-screen bg-black hidden z-30 opacity-30"
>
</button>

<script>
  const target = document.querySelector("nav");
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        target.classList.toggle("in-view", !entry.isIntersecting);
        if (entry.isIntersecting) {
          menu.classList.remove("openSidebar");
        }
      });
    },
    {
      threshold: 0.75,
    }
  );
  const hero = document.querySelector("#hero");
  observer.observe(hero);

  const menuButton = document.querySelector("#menu-button");
  const menu = document.querySelector("aside");
  menuButton.addEventListener("click", () => {
    menu.classList.toggle("openSidebar");
    sidemenuBg.classList.toggle("sidebarBgOpen");
  });

  const itemsMenu = document.querySelectorAll("aside a");
  itemsMenu.forEach((item) => {
    item.addEventListener("click", () => {
      menu.classList.remove("openSidebar");
      sidemenuBg.classList.remove("sidebarBgOpen");
    });
  });

  const sidemenuBg = document.querySelector("#sidemenu-bg");
  sidemenuBg.addEventListener("click", () => {
    sidemenuBg.classList.remove("sidebarBgOpen");
    menu.classList.remove("openSidebar");
  });
</script>

<style>
  .in-view {
    transform: translateY(0);
    transition: opacity 0.5s ease-in-out;
    animation: fadeIn 0.5s ease-in-out;
  }

  @keyframes fadeIn {
    from {
      transform: translateY(-100%);
    }
    to {
      transform: translateY(0);
    }
  }
  .openSidebar {
    transform: translateX(0);
    transition: transform 0.5s ease-in-out;
    animation: slideIn 0.5s ease-in-out;
  }

  .sidebarBgOpen {
    display: block;
  }
</style>
