---
import IconOne from "../components/SVG/IconOne.astro";
const Products = [
  {
    title: "Marcos a la medida",
    description:
      "Ofrecemos una amplia variedad de opciones de marcos, incluyendo diferentes estilos, colores y materiales. Cada marco se personaliza para adaptarse perfectamente a su obra de arte.",
  },
  {
    title: "Bastidores a la medida",
    description:
      "Si tienes una pintura en lienzo o cualquier otro tipo de pieza que requiere un bastidor, ofrecemos opciones personalizadas para adaptarse a tus necesidades.",
  },
  {
    title: "Espejos",
    description:
      "Además de enmarcar obras de arte, también ofrecemos servicios de enmarcado para espejos. Ofrecemos una variedad de estilos y opciones de marco para adaptarse a cualquier decoración.",
  },
  {
    title: "Montaje de oleos",
    description:
      "Si tienes una pintura al óleo que requiere un enmarcado personalizado, podemos ayudarte. Nos aseguraremos de que la pintura se conserve y se exhiba adecuadamente.",
  },
];
---

<section class="bg-gray-700 p-10 py-20" id="productos">
  <h2 class="font-semibold text-4xl mb-5">Productos</h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      Products.map((product, index) => (
        <div class="" id={`p${index + 1}`}>
          <div class="flex items-center gap-4">
            <h3 class="text-lg font-semibold text-gray-200">{product.title}</h3>
          </div>
          <p class="text-gray-300">{product.description}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  #p1 {
    animation: scaleAnim 1s ease-in-out;
  }

  #p2 {
    animation: scaleAnim 1.2s ease-in-out;
  }

  #p3 {
    animation: scaleAnim 1.5s ease-in-out;
  }

  #p4 {
    animation: scaleAnim 2s ease-in-out;
  }

  @keyframes scaleAnim {
    from {
      transform: translateX(-2000px);
      opacity: 0;
    }
    to {
      transform: translateX(0);
      opacity: 1;
    }
  }
</style>
