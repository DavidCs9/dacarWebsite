---
import { Image } from "astro:assets";
import HeroImage from "../images/inicio.webp";
---

<section
  id="hero"
  class="bg-gray-900 h-screen flex flex-col md:flex-row gap-16 p-10 justify-center items-center"
>
  <div class="flex flex-col gap-2">
    <h1
      class="mb-4 text-4xl font-extrabold tracking-wide leading-none md:text-5xl xl:text-6xl text-white"
    >
      DACAR
    </h1>
    <h2
      class="max-w-2xl mb-4 text-2xl tracking-tight leading-none md:text-2xl xl:text-3xl text-gray-200"
    >
      Enmarcado a la medida
    </h2>
    <p
      class="max-w-2xl mb-6 font-light text-gray-400 lg:mb-8 md:text-lg lg:text-xl dark:text-gray-400"
    >
      Ofrecemos enmarcado personalizado de alta calidad para cuadros y obras de
      arte, con atención al cliente excepcional.
    </p>
    <a
      href="#contacto"
      class="items-center mx-auto md:ml-0 px-5 py-3 text-base text-center text-white rounded-lg bg-blue-600 font-semibold hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 dark:focus:ring-blue-900 flex gap-2"
    >
      Contactanos
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        ><path
          fill="currentColor"
          d="M6.62 10.79c1.44 2.83 3.76 5.15 6.59 6.59l2.2-2.2c.28-.28.67-.36 1.02-.25c1.12.37 2.32.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57c.11.35.03.74-.25 1.02z"
        ></path></svg
      >
    </a>
  </div>
  <div class="place-items-center">
    <Image src={HeroImage} alt="Muestra de cuadros" />
  </div>
</section>
